## Exercício 30 — Caixa eletrônico
```
ALGORITMO CaixaEletronico
VAR
    saldo, valor: real
    opcao: inteiro
INICIO
    saldo <- 1000.00
    opcao <- 0

    ENQUANTO opcao != 4 FACA
        ESCREVA("1. Consultar saldo")
        ESCREVA("2. Depositar")
        ESCREVA("3. Sacar")
        ESCREVA("4. Sair")
        ESCREVA("Escolha uma opcao: ")
        LEIA(opcao)

        SE opcao == 1 ENTAO
            ESCREVA("Saldo atual: ", saldo)
        SENAO
            SE opcao == 2 ENTAO
                ESCREVA("Digite o valor do deposito: ")
                LEIA(valor)
                saldo <- saldo + valor
                ESCREVA("Deposito realizado. Novo saldo: ", saldo)
            SENAO
                SE opcao == 3 ENTAO
                    ESCREVA("Digite o valor do saque: ")
                    LEIA(valor)
                    SE valor <= saldo ENTAO
                        saldo <- saldo - valor
                        ESCREVA("Saque realizado. Novo saldo: ", saldo)
                    SENAO
                        ESCREVA("Saldo insuficiente.")
                    FIMSE
                SENAO
                    SE opcao != 4 ENTAO
                        ESCREVA("Opcao invalida.")
                    FIMSE
                FIMSE
            FIMSE
        FIMSE
    FIMENQUANTO

    ESCREVA("Encerrando o sistema. Ate logo!")

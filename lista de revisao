## Exercício 20 — Calculadora
```
ALGORITMO Calculadora
VAR
    num1, num2, resultado: real
    operacao: caractere
INICIO
    ESCREVA("Digite o primeiro numero: ")
    LEIA(num1)
    ESCREVA("Digite o segundo numero: ")
    LEIA(num2)
    ESCREVA("Digite a operacao (+, -, *, /): ")
    LEIA(operacao)

    SE operacao == '+' ENTAO
        resultado <- num1 + num2
        ESCREVA("Resultado: ", resultado)
    SENAO
        SE operacao == '-' ENTAO
            resultado <- num1 - num2
            ESCREVA("Resultado: ", resultado)
        SENAO
            SE operacao == '*' ENTAO
                resultado <- num1 * num2
                ESCREVA("Resultado: ", resultado)
            SENAO
                SE operacao == '/' ENTAO
                    SE num2 == 0 ENTAO
                        ESCREVA("Erro: divisao por zero")
                    SENAO
                        resultado <- num1 / num2
                        ESCREVA("Resultado: ", resultado)
                    FIMSE
                SENAO
                    ESCREVA("Operacao invalida")
                FIMSE
            FIMSE
        FIMSE
    FIMSE
FIMALGORITMO
```


## Exercício 34 — Sistema de vendas
```
ALGORITMO SistemaVendas
VAR
    continuar: caractere
    produto: cadeia
    quantidade: inteiro
    precoUnitario, totalVenda, faturamentoTotal, maiorVenda: real
    qtdVendas, totalProdutosVendidos: inteiro
INICIO
    qtdVendas <- 0
    totalProdutosVendidos <- 0
    faturamentoTotal <- 0
    maiorVenda <- 0

    ESCREVA("Deseja registrar uma venda? (S/N): ")
    LEIA(continuar)

    ENQUANTO continuar == 'S' FACA
        ESCREVA("Digite o nome do produto: ")
        LEIA(produto)
        ESCREVA("Digite a quantidade: ")
        LEIA(quantidade)
        ESCREVA("Digite o preco unitario: ")
        LEIA(precoUnitario)

        totalVenda <- quantidade * precoUnitario

        qtdVendas <- qtdVendas + 1
        totalProdutosVendidos <- totalProdutosVendidos + quantidade
        faturamentoTotal <- faturamentoTotal + totalVenda

        SE totalVenda > maiorVenda ENTAO
            maiorVenda <- totalVenda
        FIMSE

        ESCREVA("Deseja registrar outra venda? (S/N): ")
        LEIA(continuar)
    FIMENQUANTO

    ESCREVA("Quantidade de vendas realizadas: ", qtdVendas)
    ESCREVA("Quantidade total de produtos vendidos: ", totalProdutosVendidos)
    ESCREVA("Faturamento total: ", faturamentoTotal)
    ESCREVA("Maior venda realizada: ", maiorVenda)
FIMALGORITMO
```

## Exercício 35 — Sistema acadêmico
```
ALGORITMO SistemaAcademico
VAR
    qtdAlunos, i: inteiro
    nome: cadeia
    n1, n2, media: real
    aprovados, recuperacao, reprovados: inteiro
    somaMedias, mediaGeral, maiorMedia, menorMedia: real
INICIO
    ESCREVA("Digite a quantidade de alunos: ")
    LEIA(qtdAlunos)

    aprovados <- 0
    recuperacao <- 0
    reprovados <- 0
    somaMedias <- 0
    maiorMedia <- 0
    menorMedia <- 10

    PARA i DE 1 ATE qtdAlunos FACA
        ESCREVA("Digite o nome do aluno: ")
        LEIA(nome)
        ESCREVA("Digite a nota da primeira avaliacao: ")
        LEIA(n1)
        ESCREVA("Digite a nota da segunda avaliacao: ")
        LEIA(n2)

        media <- (n1 + n2) / 2
        somaMedias <- somaMedias + media

        SE media >= 7 ENTAO
            aprovados <- aprovados + 1
        SENAO
            SE media >= 5 ENTAO
                recuperacao <- recuperacao + 1
            SENAO
                reprovados <- reprovados + 1
            FIMSE
        FIMSE

        SE media > maiorMedia ENTAO
            maiorMedia <- media
        FIMSE
        SE media < menorMedia ENTAO
            menorMedia <- media
        FIMSE

        ESCREVA(nome, " - Media: ", media)
    FIMPARA

    mediaGeral <- somaMedias / qtdAlunos

    ESCREVA("Quantidade de alunos: ", qtdAlunos)
    ESCREVA("Aprovados: ", aprovados)
    ESCREVA("Em recuperacao: ", recuperacao)
    ESCREVA("Reprovados: ", reprovados)
    ESCREVA("Media geral da turma: ", mediaGeral)
    ESCREVA("Maior media: ", maiorMedia)
    ESCREVA("Menor media: ", menorMedia)
FIMALGORITMO
